  "description": "Encodes sign videos for Find Sign with ffmpeg: an h264 mp4 and a vp9 webm within 640x360, and a webp thumbnail",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andypalmer/find-sign-pipeline.git",
    "directory": "packages/encoder"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
